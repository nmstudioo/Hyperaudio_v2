desc: HyperAudio IEM v5 Advanced R - Presets Effects Safety
//tags: hyperaudio iem edx preset deesser limiter lookahead safety hrir

// ============================================================
// CHAIN: HA_IEM_v5_Advanced_R.vdc -> HA_IEM_v3xHRIR_v5.irs (4 channel, preamp 0 dB) -> this script
//   The IRS already carries the tonal correction AND the HRIR crossfeed.
//   This script adds no static tonal EQ. Surround and width here are EXTRA and default to 0.
// Preset selects a tuned bundle. Manual uses the sliders below. Bundles are design choices, not measured.
// Safety: always-on final clamp, 50 ms start fade, NaN-safe guards, custom ceiling capped at -0.3 dBFS.
// A sample-peak limiter is not true-peak protection and not a hearing-safety device.
// Bypass is delayed by LOOK samples (1 ms @ 48 kHz) by design; both paths share the delay.
// ============================================================

// PRESET
preset:1<0,4,1{Manual,Balanced,Clarity,Immersive,Safe night}>Preset

// MASTER AND PROCESSING PATH
master:1<0,1,1{Off,On}>Master
procMode:0<0,1,1{Effects,Limiter only}>Processing mode

// LIMITER
limMode:0<0,4,1{Default,Safe,Transparent,Customize,Full bypass}>Limiter mode
customCeil10:-15<-600,0,1>Custom ceiling tenths dBFS
customRelease:80<10,500,1>Custom release ms

// INPUT
input10:0<-120,0,1>Input gain tenths dB

// CLARITY AND SPACE
dsAmt:40<0,100,1>Deesser Amount
dsThr10:-200<-500,-100,1>Deesser Threshold tenths dBFS
sur3d:0<0,100,1>Extra Surround 3D Amount
spaceW10:0<0,60,1>Extra Space Width tenths dB

@init
// MANDATORY: every slider reassigned
preset        = 1;
master        = 1;
procMode      = 0;
limMode       = 0;
customCeil10  = -15;
customRelease = 80;
input10       = 0;
dsAmt         = 40;
dsThr10       = -200;
sur3d         = 0;
spaceW10      = 0;

// Constants
fs   = srate > 0 ? srate : 48000;
LOOK = 48;              // delay-line length / lookahead (1 ms @ 48 kHz)
WIN  = LOOK + 1;        // sliding window: LOOK+1 so peak req is still in window at output time

// Derived (initial values; refreshed on change inside the sample section)
effCeil  = -1.5;
effRel   = 80;
ceil_lin = 10 ^ (effCeil / 20);
rel_k    = exp(-1 / (fs * effRel * 0.001));
ig_lin   = 1.0;

// Buffer layout - offset avoids collision with VM variables
mem     = 10000;
D_BUF_L = mem;              // size LOOK
D_BUF_R = D_BUF_L + LOOK;   // size LOOK
G_BUF   = D_BUF_R + LOOK;   // size WIN
P_BUF   = G_BUF + WIN;      // size WIN
S_BUF   = P_BUF + WIN;      // size WIN + 1

// Init buffers (parenthesized loop bodies for parser safety)
i = 0;
loop(LOOK, (D_BUF_L[i] = 0; D_BUF_R[i] = 0; i += 1;));
i = 0;
loop(WIN, (G_BUF[i] = 1; P_BUF[i] = 1; i += 1;));
i = 0;
loop(WIN + 1, (S_BUF[i] = 1e30; i += 1;));

// ---- v4 effect constants ----
pi2 = 6.28318530718;
// Deesser band-pass at 6.5 kHz, Q 1.0 (RBJ constant 0 dB peak)
w0 = pi2 * 6500 / fs;
c0 = cos(w0);
al = sin(w0) / 2.0;
a0 = 1.0 + al;
ds_b0 = al / a0;
ds_b2 = -al / a0;
ds_a1 = -2.0 * c0 / a0;
ds_a2 = (1.0 - al) / a0;
ds1L = 0; ds2L = 0; ds1R = 0; ds2R = 0;
dsEnv = 0; dsGR = 0;
dsAtk  = 1.0 - exp(-1.0 / (fs * 0.0003));
dsRel  = 1.0 - exp(-1.0 / (fs * 0.040));
dsGAtk = 1.0 - exp(-1.0 / (fs * 0.0005));
dsGRel = 1.0 - exp(-1.0 / (fs * 0.050));
ds_maxgr = 4.8;
ds_thr   = 0.1;
// Crossfeed: one-pole low-pass 700 Hz on the cross path, 0.28 ms delay
xfA = 1.0 - exp(-pi2 * 700 / fs);
XDLY = floor(0.00028 * fs + 0.5);
XDLY < 1 ? XDLY = 1;
XDLY > 30 ? XDLY = 30;
XB_L = 12000;
XB_R = 12032;
i = 0;
loop(32, (XB_L[i] = 0; XB_R[i] = 0; i += 1;));
xwr = 0;
xfL = 0; xfR = 0;
xf_g = 0.2;
// Space width: side-channel high shelf above 3 kHz
wA = 1.0 - exp(-pi2 * 3000 / fs);
wSlp = 0;
w_lin = 0.1220;
// Delayed processed path (limiter output) buffers
PD_L = 12100;
PD_R = 12200;
i = 0;
loop(LOOK, (PD_L[i] = 0; PD_R[i] = 0; i += 1;));
effCtl = 0;
prevDsAmt = -99999;
prevDsThr = -99999;
prevSur   = -99999;
prevSpace = -99999;

// Limiter state
dhead = 0;
bpos  = 0;
gs    = 1.0;

// Change tracking (sentinel forces first-sample refresh)
prevMode     = -99999;
prevProcMode = -99999;
prevCeil10   = -99999;
prevRelease  = -99999;
prevInput10  = -99999;

// Bypass crossfade
bypass_state  = 0;
bypass_target = 0;
bypass_inc    = 1 / (0.020 * fs);

// Safety and preset state
fadeIn  = 0;
fadeInc = 1.0 / (0.05 * fs);
eDs = 40; eThr = -200; eSur = 0; eWid = 0; eLim = 0; eCC = -15; eCR = 80; eIn = 0;

@sample
// Input guard (NaN-safe form: a negated comparison is not NaN-safe in this VM)
abs(spl0) < 1e6 ? 0 : (spl0 = 0.0);
abs(spl1) < 1e6 ? 0 : (spl1 = 0.0);

// Effective settings: preset bundle or manual sliders
preset == 0 ? (
  eDs = dsAmt; eThr = dsThr10; eSur = sur3d; eWid = spaceW10; eLim = limMode; eIn = input10;
) : preset == 1 ? (
  eDs = 40; eThr = -200; eSur = 0;  eWid = 0;  eLim = limMode; eIn = input10;
) : preset == 2 ? (
  eDs = 55; eThr = -215; eSur = 0;  eWid = 0;  eLim = limMode; eIn = input10;
) : preset == 3 ? (
  eDs = 40; eThr = -200; eSur = 25; eWid = 15; eLim = limMode; eIn = input10;
) : (
  eDs = 50; eThr = -210; eSur = 0;  eWid = 0;  eLim = 1; eIn = -30;
);
eCC = customCeil10;
eCR = customRelease;

// Parameter refresh
(eLim != prevMode) + (eCC != prevCeil10) + (eCR != prevRelease) > 0 ? (
  effCeil = -1.5;
  effRel  = 80;
  eLim == 0 ? ( effCeil = -1.5; effRel = 80;  );
  eLim == 1 ? ( effCeil = -2.0; effRel = 120; );
  eLim == 2 ? ( effCeil = -1.0; effRel = 200; );
  eLim == 3 ? ( effCeil = min(eCC / 10, -0.3); effRel = eCR; );
  ceil_lin    = 10 ^ (effCeil / 20);
  rel_k       = exp(-1 / (fs * effRel * 0.001));
  prevMode    = eLim;
  prevCeil10  = eCC;
  prevRelease = eCR;
);

(eIn != prevInput10) ? (
  ig_lin      = 10 ^ (eIn / 200);
  prevInput10 = eIn;
);

(eDs != prevDsAmt) ? (
  ds_maxgr  = eDs * 0.12;
  prevDsAmt = eDs;
);
(eThr != prevDsThr) ? (
  ds_thr    = 10 ^ (eThr / 200);
  prevDsThr = eThr;
);
(eSur != prevSur) ? (
  xf_g    = 0.5 * eSur / 100;
  prevSur = eSur;
);
(eWid != prevSpace) ? (
  w_lin     = 10 ^ (eWid / 200) - 1;
  prevSpace = eWid;
);

// Bypass target
bypass_target = 0;
master == 0  ? bypass_target = 1;
eLim == 4 ? bypass_target = 1;

bypass_state < bypass_target ? (
  bypass_state = min(bypass_target, bypass_state + bypass_inc);
) : (
  bypass_state = max(bypass_target, bypass_state - bypass_inc);
);

// Raw input (guarded)
x0 = spl0;
x1 = spl1;

// Effects mode is the default. Limiter-only leaves p0/p1 untouched.
p0 = x0;
p1 = x1;
(procMode != prevProcMode) ? (
  // Clear effect memories on every path switch; no stale state on re-entry.
  ds1L = 0; ds2L = 0; ds1R = 0; ds2R = 0; dsEnv = 0; dsGR = 0;
  xfL = 0; xfR = 0; wSlp = 0; xwr = 0;
  i = 0;
  loop(32, (XB_L[i] = 0; XB_R[i] = 0; i += 1;));
  prevProcMode = procMode;
);
procMode == 0 ? (

// 1 Deesser (split band, linked detection, idle = exact passthrough)
eDs > 0 ? (
  bpL = ds_b0 * x0 + ds1L;
  ds1L = 0 - ds_a1 * bpL + ds2L;
  ds2L = ds_b2 * x0 - ds_a2 * bpL;
  bpR = ds_b0 * x1 + ds1R;
  ds1R = 0 - ds_a1 * bpR + ds2R;
  ds2R = ds_b2 * x1 - ds_a2 * bpR;
  abs(bpL) < 1e6 ? 0 : (bpL = 0.0; ds1L = 0.0; ds2L = 0.0;);
  abs(bpR) < 1e6 ? 0 : (bpR = 0.0; ds1R = 0.0; ds2R = 0.0;);
  det = max(abs(bpL), abs(bpR));
  det > dsEnv ? (
    dsEnv += dsAtk * (det - dsEnv);
  ) : (
    dsEnv += dsRel * (det - dsEnv);
  );
  gr = 0;
  dsEnv > ds_thr ? (
    gr = min(ds_maxgr, 8.685889638 * log(dsEnv / ds_thr) * 0.6667);
  );
  gr > dsGR ? (
    dsGR += dsGAtk * (gr - dsGR);
  ) : (
    dsGR += dsGRel * (gr - dsGR);
  );
  dsGain = 1.0;
  dsGR > 0.0001 ? dsGain = exp(0 - dsGR * 0.1151292546);
  p0 = x0 - (1.0 - dsGain) * bpL;
  p1 = x1 - (1.0 - dsGain) * bpR;
);

// 2 Surround: crossfeed built as a delayed low-passed side cut, so the mid (mono) signal is exactly untouched
eSur > 0 ? (
  xfL += xfA * (p0 - xfL);
  xfR += xfA * (p1 - xfR);
  XB_L[xwr] = xfL;
  XB_R[xwr] = xfR;
  xrd = xwr - XDLY;
  xrd < 0 ? xrd += 32;
  dxl = XB_L[xrd];
  dxr = XB_R[xrd];
  q0 = p0 - xf_g * dxl + xf_g * dxr;
  q1 = p1 - xf_g * dxr + xf_g * dxl;
  xwr += 1;
  xwr >= 32 ? xwr = 0;
  p0 = q0;
  p1 = q1;
);

// 3 Space width: side high shelf, mid untouched
eWid > 0 ? (
  mid  = (p0 + p1) * 0.5;
  side = (p0 - p1) * 0.5;
  wSlp += wA * (side - wSlp);
  side2 = side + w_lin * (side - wSlp);
  p0 = mid + side2;
  p1 = mid - side2;
);

// State guards and slow denormal cleanup
effCtl += 1;
effCtl >= 1024 ? (
  effCtl = 0;
  abs(ds1L) < 1e-30 ? ( ds1L = 0; ds2L = 0; );
  abs(ds1R) < 1e-30 ? ( ds1R = 0; ds2R = 0; );
  abs(dsEnv) < 1e-30 ? dsEnv = 0;
  abs(xfL) < 1e-30 ? xfL = 0;
  abs(xfR) < 1e-30 ? xfR = 0;
  abs(wSlp) < 1e-30 ? wSlp = 0;
);

 );

// Gain request (input gain included in sensitivity)
pk  = max(abs(p0 * ig_lin), abs(p1 * ig_lin));
req = pk > ceil_lin ? ceil_lin / pk : 1.0;

// Sliding-window min (prefix + suffix)
G_BUF[bpos] = req;
bpos == 0 ? (
  P_BUF[0] = req;
) : (
  P_BUF[bpos] = min(P_BUF[bpos - 1], req);
);

win_min = min(P_BUF[bpos], S_BUF[bpos + 1]);

bpos += 1;
bpos >= WIN ? (
  S_BUF[WIN - 1] = G_BUF[WIN - 1];
  i = WIN - 2;
  loop(WIN - 1, (S_BUF[i] = min(G_BUF[i], S_BUF[i + 1]); i -= 1;));
  S_BUF[WIN] = 1e30;
  bpos = 0;
);

// Instant attack (preemptive: peak enters window 48 samples before it hits output)
// Exponential release (smooth recovery after peaks leave the window)
win_min < gs ? (
  gs = win_min;
) : (
  gs = rel_k * gs + (1 - rel_k) * win_min;
);

// Delay lines (raw for bypass, processed for the limiter path)
dly_l = D_BUF_L[dhead];
dly_r = D_BUF_R[dhead];
pd_l = PD_L[dhead];
pd_r = PD_R[dhead];
PD_L[dhead] = p0;
PD_R[dhead] = p1;
D_BUF_L[dhead] = x0;
D_BUF_R[dhead] = x1;
dhead += 1;
dhead >= LOOK ? dhead = 0;

// Processed path
proc_l = pd_l * ig_lin * gs;
proc_r = pd_r * ig_lin * gs;

// Bypass path (raw delayed, no gain)
byp_l = dly_l;
byp_r = dly_r;

// Crossfade
spl0 = (1 - bypass_state) * proc_l + bypass_state * byp_l;
spl1 = (1 - bypass_state) * proc_r + bypass_state * byp_r;

// Safety output stage: start fade, hard clamp, NaN-safe final guard
fadeIn < 1 ? (
  fadeIn = min(1, fadeIn + fadeInc);
  spl0 = spl0 * fadeIn;
  spl1 = spl1 * fadeIn;
);
abs(gs - 0.5) < 0.5001 ? 0 : (gs = 1.0);
hardLim = ceil_lin + bypass_state * (0.9995 - ceil_lin);
abs(spl0) < 1e6 ? 0 : (spl0 = 0.0);
abs(spl1) < 1e6 ? 0 : (spl1 = 0.0);
spl0 = min(max(spl0, -hardLim), hardLim);
spl1 = min(max(spl1, -hardLim), hardLim);
