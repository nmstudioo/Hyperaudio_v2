desc: HyperAudio Speaker Protect v7
//tags: hyperaudio speaker limiter safety lookahead

master:1<0,1,1{Bypass,Protect}>Processing
inputGain10:0<-120,60,1>Input gain 0.1 dB
ceiling10:-30<-120,0,1>Peak ceiling 0.1 dBFS
releaseMs:80<20,300,1>Release ms

// Fixed constants
// LOOK_MS 1.0 (latency equals lookahead, follows host sample rate)
// Smoothed gain ramp across the lookahead window, no tonal processing

@init
master = 1;
inputGain10 = 0;
ceiling10 = -30;
releaseMs = 80;

fs = srate > 0 ? srate : 48000;
LA = floor(0.001 * fs + 0.5);
LA < 2 ? ( LA = 2; );
LA > 500 ? ( LA = 500; );
N = LA + 1;
cap = N + 1;

dlyL = 10000;
dlyR = dlyL + N;
mBuf = dlyR + N;
dqV = mBuf + N;
dqI = dqV + cap;

i = 0;
loop(N,
  dlyL[i] = 0; dlyR[i] = 0; mBuf[i] = 1;
  i += 1;
);
i = 0;
loop(cap,
  dqV[i] = 1; dqI[i] = 0;
  i += 1;
);

head = 0; tail = 0; t = 0;
w = 0; rg = 1; msum = N; sc = 0;
prevMaster = master;

preGain = pow(10, inputGain10 / 200);
ceiling = min(max(pow(10, ceiling10 / 200), 0.001), 1);
releaseCoeff = 1 - exp(-1 / (fs * releaseMs * 0.001));
prevInputGain10 = inputGain10;
prevCeiling10 = ceiling10;
prevReleaseMs = releaseMs;

@sample
abs(spl0) < 1e6 ? 0 : (spl0 = 0.0);
abs(spl1) < 1e6 ? 0 : (spl1 = 0.0);

master == 0 ? (
  // True bypass, samples untouched
  prevMaster = 0;
) : (
  // Reset limiter history when leaving bypass
  prevMaster == 0 ? (
    i = 0;
    loop(N,
      dlyL[i] = 0; dlyR[i] = 0; mBuf[i] = 1;
      i += 1;
    );
    head = 0; tail = 0;
    msum = N; rg = 1; sc = 0;
  );
  prevMaster = 1;

  inputGain10 != prevInputGain10 ? (
    prevInputGain10 = inputGain10;
    preGain = pow(10, inputGain10 / 200);
  );
  ceiling10 != prevCeiling10 ? (
    prevCeiling10 = ceiling10;
    ceiling = min(max(pow(10, ceiling10 / 200), 0.001), 1);
  );
  releaseMs != prevReleaseMs ? (
    prevReleaseMs = releaseMs;
    releaseCoeff = 1 - exp(-1 / (fs * releaseMs * 0.001));
  );

  pL = spl0 * preGain;
  pR = spl1 * preGain;

  // Linked gain request
  pk = max(abs(pL), abs(pR));
  g = pk > ceiling ? ceiling / pk : 1;

  // Exact sliding minimum over the last N gains, monotonic deque
  t += 1;
  while (tail > head && dqV[(tail - 1) % cap] >= g) ( tail -= 1; );
  dqV[tail % cap] = g;
  dqI[tail % cap] = t;
  tail += 1;
  while (dqI[head % cap] <= t - N) ( head += 1; );
  wm = dqV[head % cap];

  // Moving average of the minimum, gives a smooth ramp instead of a step
  msum += wm - mBuf[w];
  mBuf[w] = wm;
  sc += 1;
  sc >= 4096 ? (
    sc = 0;
    msum = 0;
    i = 0;
    loop(N,
      msum += mBuf[i];
      i += 1;
    );
  );
  gs = msum / N;

  // Instant attack, smooth release
  rg = min(gs, rg + (gs - rg) * releaseCoeff);

  // Delay by LA samples and apply gain
  dlyL[w] = pL; dlyR[w] = pR;
  rd = w + 1; rd >= N ? ( rd = 0; );
  spl0 = min(max(dlyL[rd] * rg, -ceiling), ceiling);
  spl1 = min(max(dlyR[rd] * rg, -ceiling), ceiling);
  w = rd;
);
